{
    "name": "dark_plus",
    "settings": [{
        "settings": {
            "background": "#0A2129",
            "foreground": "#DDF5EA",
            "lineHighlight": "#0E2A33",
            "selection": "#0F3D31",
            "highlightedDelimitersForeground": "#02F5A1"
        }
    },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": {
                "foreground": "#47745F"
            }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": {
                "foreground": "#02F5A1"
            }
        },
        {
            "name": "Control Keyword",
            "scope": "keyword.control",
            "settings": {
                "foreground": "#7CFFC9"
            }
        },
        {
            "name": "Operator",
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#9FC5B4"
            }
        },
        {
            "name": "Operator Keywords",
            "scope": "keyword.operator.logical,keyword.operator.relational,keyword.operator.assignment,keyword.operator.comparison,keyword.operator.ternary,keyword.operator.arithmetic,keyword.operator.spread",
            "settings": {
                "foreground": "#9FC5B4"
            }
        },
        {
            "name": "Strings",
            "scope": "string,string.unquoted,comment.unused-import",
            "settings": {
                "foreground": "#4ED98F"
            }
        },
        {
            "name": "Characters",
            "scope": "constant.character",
            "settings": {
                "foreground": "#4ED98F"
            }
        },
        {
            "name": "Numbers",
            "scope": "constant.numeric",
            "settings": {
                "foreground": "#9AF5C8"
            }
        },
        {
            "name": "Constants",
            "scope": "constant.language",
            "settings": {
                "foreground": "#02F5A1"
            }
        },
        {
            "name": "Escape Sequences",
            "scope": "constant.character.escape",
            "settings": {
                "foreground": "#7CFFC9"
            }
        },
        {
            "name": "Types",
            "scope": "storage.type,entity.name.type,entity.other.inherited-class,support.type,support.class",
            "settings": {
                "foreground": "#02F5A1"
            }
        },
        {
            "name": "Storage",
            "scope": "storage,storage.modifier",
            "settings": {
                "foreground": "#02F5A1"
            }
        },
        {
            "name": "Function Definitions",
            "scope": "entity.name.function,support.function",
            "settings": {
                "foreground": "#B2FFDC"
            }
        },
        {
            "name": "Variables",
            "scope": "variable,variable.other,variable.other.readwrite,variable.other.property,variable.other.object.property",
            "settings": {
                "foreground": "#DDF5EA"
            }
        },
        {
            "name": "Parameters",
            "scope": "variable.parameter",
            "settings": {
                "foreground": "#DDF5EA"
            }
        },
        {
            "name": "Preprocessor",
            "scope": "meta.preprocessor,entity.name.function.preprocessor",
            "settings": {
                "foreground": "#7CFFC9"
            }
        },
        {
            "name": "Include",
            "scope": "keyword.control.directive.include,keyword.control.directive",
            "settings": {
                "foreground": "#7CFFC9"
            }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": {
                "foreground": "#9FC5B4"
            }
        },
        {
            "name": "Namespace",
            "scope": "entity.name.namespace,entity.name.type.namespace",
            "settings": {
                "foreground": "#02F5A1"
            }
        },
        {
            "name": "Annotations",
            "scope": "storage.type.annotation,meta.declaration.annotation",
            "settings": {
                "foreground": "#B2FFDC"
            }
        },
        {
            "name": "Heading",
            "scope": "markup.heading,entity.name.section",
            "settings": {
                "foreground": "#02F5A1"
            }
        },
        {
            "name": "Bold",
            "scope": "markup.bold",
            "settings": {
                "foreground": "#B2FFDC"
            }
        },
        {
            "name": "Italic",
            "scope": "markup.italic",
            "settings": {
                "foreground": "#7CFFC9"
            }
        },
        {
            "name": "Markup Code",
            "scope": "markup.inline.raw,markup.fenced_code",
            "settings": {
                "foreground": "#4ED98F"
            }
        },
        {
            "name": "Property Keys",
            "scope": "support.type.property-name,string.key",
            "settings": {
                "foreground": "#DDF5EA"
            }
        },
        {
            "name": "Property Values",
            "scope": "support.constant.property-value",
            "settings": {
                "foreground": "#4ED98F"
            }
        }
    ]
}
