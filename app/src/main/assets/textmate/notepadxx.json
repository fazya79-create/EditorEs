{
  "name": "Notepad++",
  "type": "dark",
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#000000",
    "editorLineNumber.foreground": "#808080",
    "editorLineNumber.activeForeground": "#000000",
    "editor.lineHighlightBackground": "#EEEEEE",
    "editor.selectionBackground": "#C0C0C0",
    "editorCursor.foreground": "#000000",
    "editorIndentGuide.background": "#D0D0D0",
    "editorIndentGuide.activeBackground": "#A0A0A0",
    "editorSuggestWidget.background": "#F0F0F0"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#008000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted.double.include"
      ],
      "settings": {
        "foreground": "#8000FF"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FF8000"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#804000"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#804000"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#0000FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "keyword.control.directive",
        "punctuation.definition.directive",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#800080"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#8000FF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#0080FF"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "string.key"
      ],
      "settings": {
        "foreground": "#804000"
      }
    },
    {
      "scope": [
        "storage.type.annotation",
        "meta.declaration.annotation",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#808000"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#800080"
      }
    }
  ]
}