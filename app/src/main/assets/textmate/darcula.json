{
  "name": "Darcula",
  "type": "dark",
  "colors": {
    "editor.background": "#2B2B2B",
    "editor.foreground": "#A9B7C6",
    "editorLineNumber.foreground": "#606366",
    "editorLineNumber.activeForeground": "#BBBBBB",
    "editor.lineHighlightBackground": "#323232",
    "editor.selectionBackground": "#214283",
    "editorCursor.foreground": "#BBBBBB",
    "editorIndentGuide.background": "#3B3B3B",
    "editorIndentGuide.activeBackground": "#606366",
    "editorSuggestWidget.background": "#2B2B2B"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#808080",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted.double.include"
      ],
      "settings": {
        "foreground": "#6A8759"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#6897BB"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#9876AA"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#CC7832"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#CC7832"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#A9B7C6"
      }
    },
    {
      "scope": [
        "keyword.control.directive",
        "punctuation.definition.directive",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#CC7832"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#FFC66D"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#A9B7C6"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#9876AA"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#A9B7C6"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#A9B7C6"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "string.key"
      ],
      "settings": {
        "foreground": "#9876AA"
      }
    },
    {
      "scope": [
        "storage.type.annotation",
        "meta.declaration.annotation",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#BBB529"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E8BF6A"
      }
    }
  ]
}